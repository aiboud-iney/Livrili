"use client"
import { useState } from "react"
import { useRouter } from "next/navigation"
import { ChevronLeft, Phone } from "lucide-react"
import type { ShipmentData, PosterData } from "../page"
import { getShipmentTypeColor, getShipmentTypeLabel } from "@/app/constants/shipment-types"
import { useLang } from "@/contexts/LanguageContext"

interface ShipmentDetailsProps {
  shipment: ShipmentData
  poster: PosterData | null
}

export function ShipmentDetails({ shipment, poster }: ShipmentDetailsProps) {
  const router = useRouter()
  const [selectedImage, setSelectedImage] = useState(0)
  const { lang } = useLang()

  // Format date range
  const formatDateRange = (startDate: string, endDate: string) => {
    const start = new Date(startDate)
    const end = new Date(endDate)
     
    const options: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' }
    const startFormatted = start.toLocaleDateString('en-US', options)
    const endFormatted = end.toLocaleDateString('en-US', options)
     
    if (start.getMonth() === end.getMonth()) {
      const startDay = start.getDate()
      const endDay = end.getDate()
      const month = start.toLocaleDateString('en-US', { month: 'short' })
      return `${month} ${startDay} - ${endDay}`
    }
     
    return `${startFormatted} - ${endFormatted}`
  }

  // Get base URL for images
  const getImageUrl = (path: string) => {
    if (path.startsWith('http')) return path
    const API_ACT_URL = process.env.NEXT_PUBLIC_API_ACT_URL || 'http://localhost:5000/api'
    return `${API_ACT_URL}/${path}`
  }

  const images = shipment.shipment_pictures && shipment.shipment_pictures.length > 0
  ? shipment.shipment_pictures
  : null

  return (
    <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
       
      {/* Back button */}
      <button
        onClick={() => router.push('/feed')}
        className="flex items-center gap-2 text-gray-500 hover:text-gray-700 mb-6 transition-colors"
      >
        <ChevronLeft className="w-5 h-5" />
        <span className="font-semibold">Back to Feed</span>
      </button>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
         
        {/* Left column - Main content */}
        <div className="lg:col-span-2 space-y-6">
           
          {/* Badge and Title */}
          <div>
            <span className="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full mb-3">
              SHIPMENT
            </span>
            <h1 className="text-3xl font-bold text-gray-900 mb-2">
              {shipment.title}
            </h1>
            <p className="text-sm text-gray-500 mb-3">
              Shipment ID: #{shipment.id} • Posted {new Date(shipment.created_at).toLocaleDateString()}
            </p>

            {shipment.shipment_type && (
              <div className="mb-3">
                {(() => {
                  const color = getShipmentTypeColor(shipment.shipment_type)
                  return (
                    <span
                      style={{
                        display: "inline-block",
                        backgroundColor: color.bg,
                        color: color.text,
                        fontSize: "12px",
                        fontWeight: 700,
                        padding: "4px 12px",
                        borderRadius: "8px",
                        border: `1px solid ${color.border || "transparent"}`,
                      }}
                    >
                      ({shipment.shipment_type}) {getShipmentTypeLabel(shipment.shipment_type, lang)}
                    </span>
                  )
                })()}
              </div>
            )}
          </div>

          {/* Image Gallery */}
          <div className="bg-white rounded-xl overflow-hidden shadow-sm">
            <div className="aspect-video bg-gray-100">
              {images ? (
                <img
                  src={getImageUrl(images[selectedImage])}
                  alt={`${shipment.title} - Image ${selectedImage + 1}`}
                  className="w-full h-full object-cover"
                  onError={(e) => { (e.currentTarget as HTMLImageElement).style.display = 'none' }}
                />
              ) : (
                <div className="w-full h-full flex items-center justify-center bg-gray-100">
                  <svg className="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
            </div>
            {images && images.length > 1 && (
              <div className="flex gap-2 p-4 overflow-x-auto">
                {images.map((img, idx) => (
                  <button
                    key={idx}
                    onClick={() => setSelectedImage(idx)}
                    className={`flex-shrink-0 w-24 h-24 rounded-lg overflow-hidden border-2 transition-all ${
                      selectedImage === idx ? 'border-purple-600' : 'border-transparent'
                    }`}
                  >
                    <img
                      src={getImageUrl(img)}
                      alt={`Thumbnail ${idx + 1}`}
                      className="w-full h-full object-cover"
                      onError={(e) => { (e.currentTarget as HTMLImageElement).style.display = 'none' }}
                    />
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Shipment Stats */}
          <div className="bg-white rounded-xl p-6 shadow-sm">
            <div className="grid grid-cols-3 gap-4">
              <div className="text-center">
                <div className="flex justify-center mb-2">
                  <div className="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                    <svg className="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                </div>
                <p className="text-xs text-gray-500 mb-1">WEIGHT</p>
                <p className="text-xl font-bold text-purple-600">{shipment.weight} Tons</p>
              </div>
               
              <div className="text-center">
                <div className="flex justify-center mb-2">
                  <div className="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                    <svg className="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                </div>
                <p className="text-xs text-gray-500 mb-1">VOLUME</p>
                <p className="text-xl font-bold text-purple-600">{shipment.volume} m³</p>
              </div>
               
              <div className="text-center">
                <div className="flex justify-center mb-2">
                  <div className="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                    <svg className="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                </div>
                <p className="text-xs text-gray-500 mb-1">PICKUP DATE</p>
                <p className="text-xl font-bold text-purple-600">
                  {formatDateRange(shipment.from_pickup_date, shipment.to_pickup_date)}
                </p>
              </div>
            </div>
          </div>

          {/* Description */}
          {shipment.description && (
            <div className="bg-white rounded-xl p-6 shadow-sm">
              <h2 className="text-xl font-bold text-gray-900 mb-4">Description</h2>
              <p className="text-gray-700 whitespace-pre-line">{shipment.description}</p>
            </div>
          )}

        </div>

        {/* Right column - Sidebar */}
        <div className="space-y-4">
           
          {/* Posted By Card */}
          <div className="bg-gradient-to-br from-purple-600 to-purple-700 rounded-xl p-6 text-white shadow-lg">
            <p className="text-sm text-purple-200 mb-3 flex items-center gap-2">
              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              POSTED BY
            </p>
             
            <div className="flex items-center gap-3 mb-4">
              <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
                <span className="text-xl font-bold">
                  {poster?.business_name?.charAt(0) || 'U'}
                </span>
              </div>
              <div className="flex-1">
                <h3 className="font-bold text-lg">
                  {poster?.business_name || 'Loading...'}
                </h3>
                <div className="flex items-center gap-1">
                  <span className="text-yellow-300">★</span>
                  <span className="text-sm">4.8</span>
                </div>
              </div>
            </div>

            <button
              onClick={() => {
                if (shipment.phone_number) {
                  window.location.href = `tel:${shipment.phone_number}`
                }
              }}
              className="w-full bg-white text-purple-600 py-3 rounded-lg font-semibold flex items-center justify-center gap-2 hover:bg-purple-50 transition-colors"
            >
              <Phone className="w-4 h-4" />
              {shipment.phone_number || '05540 32 892'}
            </button>
          </div>

          {/* Route Details */}
          <div className="bg-white rounded-xl p-6 shadow-sm">
            <h3 className="font-bold text-gray-900 mb-4 flex items-center gap-2">
              <svg className="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              ROUTE DETAILS
            </h3>

            {/* Origin */}
            <div className="mb-4 pb-4 border-b border-gray-100">
              <div className="flex items-start gap-3">
                <div className="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                  <div className="w-3 h-3 bg-purple-600 rounded-full"></div>
                </div>
                <div className="flex-1">
                  <p className="text-xs text-purple-600 font-semibold mb-1">ORIGIN (PICKUP LOCATION)</p>
                  <p className="font-bold text-gray-900 mb-1">{shipment.origin}</p>
                </div>
              </div>
            </div>

            {/* Destination */}
            <div>
              <div className="flex items-start gap-3">
                <div className="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                  <svg className="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fillRule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clipRule="evenodd" />
                  </svg>
                </div>
                <div className="flex-1">
                  <p className="text-xs text-green-600 font-semibold mb-1">DESTINATION (DELIVERY LOCATION)</p>
                  <p className="font-bold text-gray-900 mb-1">{shipment.destination}</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  )
}