# Option 1: Individual connection params
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livrili
DB_USER=postgres
DB_PASSWORD=your_password_here

# Option 2: Connection string (overrides individual params above)
# DATABASE_URL=postgresql://user:password@host:5432/livrili

JWT_SECRET=your_jwt_secret_minimum_32_characters

PORT=5000

# Brevo SMTP
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password

# Used for CORS configuration - must match your frontend URL
FRONTEND_URL=http://localhost:3000
